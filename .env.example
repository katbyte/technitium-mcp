# copy to .env (gitignored) next to docker-compose.yml
# a Technitium API token: web console -> Administration -> Sessions -> Create Token, for a user whose permissions are what the tools should be able to do
# one server takes the token alone; several take one each by the server's name: TECHNITIUM_TOKEN=ns1=<token>,ns2=<token>
TECHNITIUM_TOKEN=
# bearer token clients must send to the MCP endpoint; e.g. openssl rand -hex 32
TECHNITIUM_AUTH_TOKEN=
